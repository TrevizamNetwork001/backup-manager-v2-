POSTGRES_DB=backup_manager
POSTGRES_USER=backup_manager
POSTGRES_PASSWORD=CHANGE_ME

REDIS_PASSWORD=CHANGE_ME
BACKUP_STORAGE_ROOT=/data/backups
BACKUP_RETENTION_ENABLED=false
BACKUP_RETENTION_TIME=04:30
BACKUP_ENGINE_STALE_SECONDS=300
BACKUP_ENGINE_HEARTBEAT_SECONDS=30
BACKUP_FTP_HOST=
BACKUP_FTP_PASSIVE_ADDRESS=
# Deprecated fallback when BACKUP_FTP_PASSIVE_ADDRESS is empty:
# BACKUP_FTP_PUBLIC_IP=
BACKUP_FTP_STABLE_SECONDS=5
BACKUP_FTP_RECEIVE_TIMEOUT_SECONDS=180
BACKUP_FTP_MAX_BYTES=8388608
