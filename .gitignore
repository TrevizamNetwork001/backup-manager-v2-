app/storage/framework/cache/*
!app/storage/framework/cache/.gitignore

app/storage/framework/sessions/*
!app/storage/framework/sessions/.gitignore

app/storage/framework/views/*
!app/storage/framework/views/.gitignore

# SO/editor
.DS_Store
Thumbs.db
*.swp
*.tmp

# Python engine
__pycache__/
*.pyc

database/backups/

