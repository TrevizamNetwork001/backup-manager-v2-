# Segredos da infraestrutura
.env
.env.*
!.env.example

# Dados persistentes
storage/postgres/
storage/redis/
storage/backups/
storage/incoming/
storage/quarantine/
storage/tmp/

# Backups de configuração locais
compose.yml.bak
compose.yml.bak2
